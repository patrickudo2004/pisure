# PostgreSQL (Neon) — pooled connection string from your Neon dashboard
DATABASE_URL=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional but recommended in production:
# BETTER_AUTH_URL=https://www.pisure.com

# Public site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (see SETUP.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pisure-assets

# Public CDN URL of the R2 bucket (custom domain, e.g. https://images.pisure.com,
# or the R2 public dev URL during development)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Google OAuth (optional — button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
